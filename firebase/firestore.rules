rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function staff() {
      return request.auth != null
        && request.auth.uid in [
          "ymSAbrY795Pbt4logGE4VfnvsNU2",
          "dI1RiD5xbuawzRfruBL6WMagDr63"
        ];
    }

    function validSlot(slotId) {
      return request.resource.data.keys().hasOnly([
          'bookingId', 'room', 'date', 'start', 'minutes', 'name', 'createdBy', 'permanentId'
        ])
        && request.resource.data.keys().hasAll([
          'bookingId', 'room', 'date', 'start', 'minutes', 'name', 'createdBy'
        ])
        && (!request.resource.data.keys().hasAny(['permanentId'])
            || (request.resource.data.permanentId is string
                && request.resource.data.permanentId.matches(
                  '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}
        && request.resource.data.room is int
        && request.resource.data.room >= 1
        && request.resource.data.room <= 6
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.start is string
        && request.resource.data.start.matches('^([01][0-9]|2[0-3]):(00|30)$')
        && request.resource.data.minutes in [60, 90, 120]
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.bookingId is string
        && request.resource.data.bookingId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_r[1-6]_[0-9]{3,4}$')
        && slotId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_r[1-6]_[0-9]{3,4}$');
    }

    match /bookings/{bookingId} {
      allow read, write: if staff();
    }

    match /booking_slots_v1/{slotId} {
      allow get, list: if staff();
      allow create, update: if staff() && validSlot(slotId);
      allow delete: if staff();
    }

    match /app_settings/{settingId} {
      allow get: if staff() && settingId == "main";
      allow list: if false;
      allow create, update: if staff()
        && settingId == "main"
        && request.resource.data.keys().hasOnly([
          'startHour', 'endHour', 'roomCount', 'price60', 'price90', 'price120'
        ])
        && request.resource.data.keys().hasAll([
          'startHour', 'endHour', 'roomCount', 'price60', 'price90', 'price120'
        ])
        && request.resource.data.startHour is int
        && request.resource.data.endHour is int
        && request.resource.data.startHour >= 0
        && request.resource.data.startHour <= 23
        && request.resource.data.endHour >= 1
        && request.resource.data.endHour <= 24
        && request.resource.data.endHour > request.resource.data.startHour
        && request.resource.data.roomCount is int
        && request.resource.data.roomCount >= 1
        && request.resource.data.roomCount <= 6
        && request.resource.data.price60 is int
        && request.resource.data.price90 is int
        && request.resource.data.price120 is int
        && request.resource.data.price60 >= 0
        && request.resource.data.price90 >= 0
        && request.resource.data.price120 >= 0;
      allow delete: if false;
    }

    match /booking_identity_v1/{identityId} {
      allow get, list: if staff();
      allow create: if staff()
        && identityId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
        && request.resource.data.keys().hasOnly([
          'slotBookingId', 'date', 'room', 'start', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'slotBookingId', 'date', 'room', 'start', 'createdAt'
        ])
        && request.resource.data.slotBookingId is string
        && request.resource.data.slotBookingId.matches(
          '^[0-9]{4}-[0-9]{2}-[0-9]{2}_r[1-6]_[0-9]{3,4}$'
        )
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.room is int
        && request.resource.data.room >= 1
        && request.resource.data.room <= 6
        && request.resource.data.start is string
        && request.resource.data.start.matches('^([01][0-9]|2[0-3]):(00|30)$')
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /payment_receipts/{paymentId} {
      allow get, list: if staff();
      allow create: if staff()
        && paymentId.matches('^[A-Za-z0-9_-]{16,100}$')
        && request.resource.data.keys().hasOnly([
          'bookingId', 'date', 'room', 'amountKzt',
          'method', 'recordedBy', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'bookingId', 'date', 'room', 'amountKzt',
          'method', 'recordedBy', 'createdAt'
        ])
        && request.resource.data.bookingId is string
        && request.resource.data.bookingId.size() >= 1
        && request.resource.data.bookingId.size() <= 120
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.room is int
        && request.resource.data.room >= 1
        && request.resource.data.room <= 6
        && request.resource.data.amountKzt is int
        && request.resource.data.amountKzt > 0
        && request.resource.data.amountKzt <= 10000000
        && request.resource.data.method in ['cash', 'kaspi', 'card']
        && request.resource.data.recordedBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}

                )))
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.room is int
        && request.resource.data.room >= 1
        && request.resource.data.room <= 6
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.start is string
        && request.resource.data.start.matches('^([01][0-9]|2[0-3]):(00|30)$')
        && request.resource.data.minutes in [60, 90, 120]
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.bookingId is string
        && request.resource.data.bookingId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_r[1-6]_[0-9]{3,4}$')
        && slotId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_r[1-6]_[0-9]{3,4}$');
    }

    match /bookings/{bookingId} {
      allow read, write: if staff();
    }

    match /booking_slots_v1/{slotId} {
      allow get, list: if staff();
      allow create, update: if staff() && validSlot(slotId);
      allow delete: if staff();
    }

    match /app_settings/{settingId} {
      allow get: if staff() && settingId == "main";
      allow list: if false;
      allow create, update: if staff()
        && settingId == "main"
        && request.resource.data.keys().hasOnly([
          'startHour', 'endHour', 'roomCount', 'price60', 'price90', 'price120'
        ])
        && request.resource.data.keys().hasAll([
          'startHour', 'endHour', 'roomCount', 'price60', 'price90', 'price120'
        ])
        && request.resource.data.startHour is int
        && request.resource.data.endHour is int
        && request.resource.data.startHour >= 0
        && request.resource.data.startHour <= 23
        && request.resource.data.endHour >= 1
        && request.resource.data.endHour <= 24
        && request.resource.data.endHour > request.resource.data.startHour
        && request.resource.data.roomCount is int
        && request.resource.data.roomCount >= 1
        && request.resource.data.roomCount <= 6
        && request.resource.data.price60 is int
        && request.resource.data.price90 is int
        && request.resource.data.price120 is int
        && request.resource.data.price60 >= 0
        && request.resource.data.price90 >= 0
        && request.resource.data.price120 >= 0;
      allow delete: if false;
    }

    match /booking_identity_v1/{identityId} {
      allow get, list: if staff();
      allow create: if staff()
        && identityId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
        && request.resource.data.keys().hasOnly([
          'slotBookingId', 'date', 'room', 'start', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'slotBookingId', 'date', 'room', 'start', 'createdAt'
        ])
        && request.resource.data.slotBookingId is string
        && request.resource.data.slotBookingId.matches(
          '^[0-9]{4}-[0-9]{2}-[0-9]{2}_r[1-6]_[0-9]{3,4}$'
        )
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.room is int
        && request.resource.data.room >= 1
        && request.resource.data.room <= 6
        && request.resource.data.start is string
        && request.resource.data.start.matches('^([01][0-9]|2[0-3]):(00|30)$')
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /payment_receipts/{paymentId} {
      allow get, list: if staff();
      allow create: if staff()
        && paymentId.matches('^[A-Za-z0-9_-]{16,100}$')
        && request.resource.data.keys().hasOnly([
          'bookingId', 'date', 'room', 'amountKzt',
          'method', 'recordedBy', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'bookingId', 'date', 'room', 'amountKzt',
          'method', 'recordedBy', 'createdAt'
        ])
        && request.resource.data.bookingId is string
        && request.resource.data.bookingId.size() >= 1
        && request.resource.data.bookingId.size() <= 120
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.room is int
        && request.resource.data.room >= 1
        && request.resource.data.room <= 6
        && request.resource.data.amountKzt is int
        && request.resource.data.amountKzt > 0
        && request.resource.data.amountKzt <= 10000000
        && request.resource.data.method in ['cash', 'kaspi', 'card']
        && request.resource.data.recordedBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
